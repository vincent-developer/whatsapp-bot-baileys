# WhatsApp API Configuration
PORT=3000

# API Security
# Generate a strong random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_BEARER_TOKEN=your_secret_bearer_token_here_change_this

# Example: API_BEARER_TOKEN=a8f5e2c9d4b6a1e3f7c8d2b5a9e6f3c1d7b4a8e2f9c6d3b7a1e5f8c2d6b9a3e7