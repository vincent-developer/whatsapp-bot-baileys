# WhatsApp API Configuration
PORT=3000

# API Security
# Generate a strong random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_BEARER_TOKEN=your_secret_bearer_token_here_change_this

# Example: API_BEARER_TOKEN=a8f5e2c9d4b6a1e3f7c8d2b5a9e6f3c1d7b4a8e2f9c6d3b7a1e5f8c2d6b9a3e7

# --- Google Sheets (Schedule Checker / jadwal) ---
# Spreadsheet ID from the sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=1xMNjbpQJhh8jTOaNlxPWy9B2nTEMBAURR9Ys3O90jlM

# Tab name (exact title of the worksheet)
GOOGLE_SHEET_TAB_NAME=Jadwal Pasdior

# Preferred: path to service account JSON (e.g. .secrets/google_credential.json).
# Share the spreadsheet with the service account email (client_email inside the JSON) as Viewer.
GOOGLE_CREDENTIALS_PATH=.secrets/google_credential.json

# Alternative: env-based credentials (omit GOOGLE_CREDENTIALS_PATH or leave file missing)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
